{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@features/*": ["src/features/*"],
      "@shell/*": ["src/shell/*"]
    },
    "types": ["node", "vite/client"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": false,
    "outDir": ".test-dist",
    "rootDir": "."
  },
  "include": [
    "tests/**/*.ts",
    "src/components/modal/standard-modal-close.ts",
    "src/features/file-preview/previewers/media-preview-path.ts",
    "src/features/file-preview/previewers/image-load-state.ts",
    "src/features/file-explorer/file-tree-data.ts",
    "src/features/file-explorer/file-tree-selection.ts",
    "src/shell/layout/window-performance-policy.ts",
    "src/features/workspace-hub/station-action-command-sheet-focus.ts",
    "src/features/git/components/git-helpers.ts",
    "src/features/terminal/station-terminal-input-buffer.ts",
    "src/features/terminal/station-terminal-runtime-state.ts",
    "src/features/terminal/station-terminal-restore-state.ts",
    "src/features/terminal/station-terminal-document-scope.ts",
    "src/features/terminal/station-terminal-render-recovery.ts",
    "src/features/terminal/station-terminal-replay-source.ts",
    "src/features/terminal/terminal-debug-model.ts",
    "src/features/terminal/terminal-stream-decoder.ts",
    "src/features/terminal/terminal-vt-parser.ts",
    "src/features/tool-adapter/channel-message-bubble-model.ts",
    "src/features/tool-adapter/channel-message-layout.ts",
    "src/features/workspace-hub/station-task-ack-emoji.ts",
    "src/features/workspace-hub/station-mutation-error.ts",
    "src/features/workspace-hub/station-model.ts",
    "src/features/settings/update-preferences-model.ts",
    "src/features/git/controllers/git-merge-state.ts",
    "src/shell/i18n/messages.ts",
    "src/shell/i18n/ui-locale.ts",
    "src/shell/state/workspace-tab-normalization.ts",
    "src/shell/state/workspace-terminal-session-store.ts",
    "src/shell/layout/workspace-git-summary-model.ts"
  ]
}
